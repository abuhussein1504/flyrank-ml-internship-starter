        "history_gap = con.sql(f\"\"\"\n",
        "    SELECT\n",
        "        COUNT(*) AS n_clients,\n",
        "        SUM(CASE WHEN gsc_data_start >= DATE '2026-03-01' THEN 1 ELSE 0 END) AS clients_starting_in_or_after_march\n",
        "    FROM {DIM_CLIENTS}\n",
        "\"\"\").df()\n",
        "history_gap"
